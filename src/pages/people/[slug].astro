---
import Base from "@/layouts/Base.astro";
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";

export async function getStaticPaths() {
  const people = await getCollection("people");
  return people.map((person) => ({
    params: {
      slug: person.slug,
    },
    props: {
      person,
    },
  }));
}

const { person } = Astro.props;
const { Content } = await render(person);
---

<Base
  title={person.data.fullName}
>
  <article class="prose">
    <h1>{person.data.fullName}</h1>

    {person.data.photo && (
      <Image src={person.data.photo} alt={person.data.fullName} />
    )}

    <section class="block">
      <h2>Background</h2>
      <ul>
        {person.data.credentials.map((credential) => (
          <li>{credential}</li>
        ))}
      </ul>
    </section>

    {person.data.links && (
      <section class="block">
        <h2>Links</h2>
        <ul>
          {person.data.links.map((link) => (
            <li><a href={link.url}>{link.label}</a></li>
          ))}
        </ul>
      </section>
    )}
    
    <Content />
  </article>
</Base>
