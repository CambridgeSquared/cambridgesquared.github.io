---
import { Image } from "astro:assets";
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  photo?: ImageMetadata | null;
  href?: string | null;
}
const {
  name,
  photo = null,
  href = null
} = Astro.props;

// Open external links in a new tab/window.
let isExternal = false;
if (href !== null) {
  try {
    const targetUrl = new URL(href, Astro.url);
    isExternal = targetUrl.host !== Astro.url.host;
  } catch (e) {
    isExternal = false;
  }
}
---

{href ? (
  <a href={href} target={isExternal ? "_blank" : undefined} class="people-card">
    {photo && (
      <div class="people-card-photo">
        <Image src={photo} alt={name} />
      </div>
    )}
    <div class="people-card-content">
      <span>{name}</span>
    </div>
  </a>
) : (
  <div class="people-card">
    {photo && (
      <div class="people-card-photo">
        <Image src={photo} alt={name} />
      </div>
    )}
    <div class="people-card-content">
      <span>{name}</span>
    </div>
  </div>
)}

<style>
  .people-card {
    overflow: hidden;
    display: flex;
    flex-direction: column;
    border: 2px solid var(--border);
    border-radius: 4px;
    box-shadow: 0 2px 2px var(--border);
    transition:
      transform 0.2s ease;
      box-shadow 0.2s ease;
  }

  a.people-card {
    text-decoration: none;
  }

  a.people-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 4px 8px var(--border);
    color: var(--link);
  }

  .people-card-content {
    padding: var(--space-2);
  }

  .people-card-photo {
    overflow: hidden;
    width: 100%;
    height: auto;
  }

  .people-card-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    padding: 0;
    margin: 0;
  }
</style>
