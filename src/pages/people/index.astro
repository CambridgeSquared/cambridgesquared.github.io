---
import Base from "@/layouts/Base.astro";
import PeopleCard from "@/components/PeopleCard.astro";
import { getCollection } from "astro:content";
import { site } from "@/content/site";

const title = `People — ${site.name}`
const people = await getCollection("people");
people.sort((a, b) => a.data.lastName.localeCompare(b.data.lastName));
---

<Base
  title={title}
  description={`People in ${site.name}`}
  canonicalPath="/people"
>
  <article class="prose">
    <h1>People</h1>
    <p class="lead">
      Our group members and faculty sponsors.
    </p>

    <section class="block">
      <h2>Group members</h2>
      <ul class="people-grid">
        {people.map((person) => (
          <li>
            <PeopleCard
              name={person.data.fullName}
              href={`/people/${person.slug}`}
            />
          </li>
        ))}
      </ul>
    </section>

    <section class="block">
      <h2>Faculty sponsors</h2>
      <ul class="people-grid">
        <li>
          <PeopleCard
            name="Prof. Ying Jin"
            href="https://www.arct.cam.ac.uk/people/professor-ying-jin"
          />
        <li>
          <PeopleCard
            name="Dr. Ramit Debnath"
            href="https://www.arct.cam.ac.uk/people/ramit-debnath"
          />
        </li>
      </ul>
    </section>
  </article>
</Base>

<style>
  .people-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }

  ul.people-grid {
    list-style-type: none;
    padding: 0;
    margin: 0;
  }

  @media screen and (min-width: 640px) {
    .people-grid {
        grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (min-width: 768px) {
    .people-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
