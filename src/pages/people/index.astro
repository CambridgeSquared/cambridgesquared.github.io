---
import Base from "@/layouts/Base.astro";
import { getCollection } from "astro:content";
import { site } from "@/content/site";

const title = `People — ${site.name}`
const people = await getCollection("people");
people.sort((a, b) => a.data.lastName.localeCompare(b.data.lastName));
---

<Base
  title={title}
  description={`People in ${site.name}`}
  canonicalPath="/people"
>
  <article class="prose">
    <h1>People</h1>
    <p class="lead">
      Our group members and faculty sponsors.
    </p>

    <section class="block">
      <h2>Group members</h2>
      <ul>
        {people.map((person) => (
          <li><a href={`/people/${person.slug}`}>{person.data.fullName}</a></li>
        ))}
      </ul>
    </section>

    <section class="block">
      <h2>Faculty sponsors</h2>
      <ul>
        <li><a href="https://www.arct.cam.ac.uk/people/professor-ying-jin">Prof. Ying Jin</a></li>
        <li><a href="https://www.arct.cam.ac.uk/people/ramit-debnath">Dr. Ramit Debnath</a></li>
      </ul>
    </section>
  </article>
</Base>
